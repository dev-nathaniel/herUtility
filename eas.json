{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "https://her-utility.nw.r.appspot.com/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://her-utility.nw.r.appspot.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://her-utility.nw.r.appspot.com/api"
      }
    },
    "ios-simulator": {
      "ios": {
        "simulator": true
      },
      "extends": "development"
    }
  },
  "submit": {
    "production": {}
  }
}